<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Profile | Mubeezi Dating</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#fff5f7;color:#333}
header{background:#e91e63;color:#fff;text-align:center;padding:20px}
header h1{margin:0;font-size:26px}
header p{margin:6px 0 0}
nav{background:#fff;padding:12px;text-align:center;box-shadow:0 2px 6px #ddd;position:sticky;top:0;z-index:5}
nav a{display:inline-block;margin:5px 9px;color:#d81b60;text-decoration:none;font-weight:bold;font-size:14px}
.container{max-width:1000px;margin:25px auto;padding:15px}
.status{background:#fff;padding:18px;border-radius:12px;text-align:center;color:#777;margin-bottom:16px}
.error{color:#c62828}
.profile{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 3px 15px #00000012}
.cover{height:135px;background:linear-gradient(120deg,#e91e63,#ff80ab)}
.profile-content{padding:20px;text-align:center}
.avatar{width:155px;height:155px;object-fit:cover;border-radius:50%;border:5px solid white;margin-top:-95px;background:#fce4ec}
.name{color:#c2185b;margin:12px 0 5px;font-size:25px}
.location{color:#888;margin:5px}
.bio{margin:18px auto;max-width:650px;line-height:1.6;color:#555;white-space:pre-wrap;overflow-wrap:anywhere}
.details{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;text-align:left;margin-top:22px}
.detail{background:#fff5f7;padding:14px;border-radius:10px;min-width:0}
.detail strong{display:block;color:#c2185b;margin-bottom:6px}
.detail span{overflow-wrap:anywhere}
.buttons{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:24px}
.btn{display:inline-block;border:0;border-radius:22px;padding:12px 20px;text-decoration:none;font-weight:bold;cursor:pointer;font-size:14px}
.edit{background:#e91e63;color:white}
.preview{background:#fce4ec;color:#c2185b}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0 14px}
.tab{border:0;background:#fff;color:#c2185b;padding:12px 17px;border-radius:22px;font-weight:bold;cursor:pointer}
.tab.active{background:#e91e63;color:#fff}
.panel{background:#fff;border-radius:15px;padding:18px;box-shadow:0 3px 15px #0000000d}
.panel h2{margin:0 0 6px;color:#c2185b;font-size:21px}
.panel-note{margin:0 0 16px;color:#777;font-size:13px;line-height:1.5}
.count{display:inline-flex;align-items:center;justify-content:center;min-width:25px;height:25px;padding:0 7px;border-radius:20px;background:#fce4ec;color:#c2185b;margin-left:5px;font-size:12px}
.member-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:13px}
.member-card{border:1px solid #f3dce3;border-radius:12px;padding:13px;display:flex;align-items:center;gap:12px;min-width:0}
.member-card img{width:66px;height:66px;object-fit:cover;border-radius:50%;background:#fce4ec;flex-shrink:0}
.member-info{min-width:0;flex:1}
.member-info strong{display:block;color:#c2185b;margin-bottom:5px;overflow-wrap:anywhere}
.member-info small{display:block;color:#777;margin-bottom:8px}
.member-info a{color:#e91e63;font-weight:bold;text-decoration:none;font-size:13px}
.empty{background:#fff5f7;border-radius:10px;padding:22px;text-align:center;color:#777;line-height:1.5}
.loading{color:#777;text-align:center;padding:18px}
.hidden{display:none!important}
footer{text-align:center;color:#888;font-size:12px;padding:25px 12px}
@media(max-width:520px){.container{padding:10px}.profile-content{padding:15px}.member-list{grid-template-columns:1fr}.tab{flex:1;padding:11px 9px;font-size:13px}}
</style>
</head>
<body>
<header>
<h1>❤️ Mubeezi Dating</h1>
<p>Connecting Hearts Worldwide</p>
</header>

<nav>
<a href="home.html">Home</a>
<a href="discover.html">Discover</a>
<a href="likes.html">Likes</a>
<a href="matches.html">Matches</a>
<a href="messages.html">Messages</a>
<a href="notifications.html">Notifications</a>
<a href="my-profile.html">My Profile</a>
</nav>

<main class="container">
<div id="status" class="status">Loading your profile...</div>

<section id="profile" class="profile hidden">
<div class="cover"></div>
<div class="profile-content">
<img id="photo" class="avatar" alt="Your profile photo">
<h2 id="name" class="name">Mubeezi Member</h2>
<p id="ageCountry" class="location"></p>
<p id="bio" class="bio"></p>

<div class="details">
<div class="detail"><strong>Occupation</strong><span id="occupation">Not provided</span></div>
<div class="detail"><strong>Education</strong><span id="education">Not provided</span></div>
<div class="detail"><strong>Interests</strong><span id="interests">Not provided</span></div>
<div class="detail"><strong>Relationship Goal</strong><span id="relationshipGoal">Not provided</span></div>
<div class="detail"><strong>Country</strong><span id="country">Not provided</span></div>
<div class="detail"><strong>Profile Status</strong><span id="profileStatus">Not provided</span></div>
</div>

<div class="buttons">
<a href="edit-profile.html" class="btn edit">✏️ Edit My Profile</a>
<a href="profile-preview.html" class="btn preview">👁 Preview My Profile</a>
</div>
</div>
</section>

<div id="likesArea" class="hidden">
<div class="tabs" role="tablist" aria-label="My likes">
<button type="button" class="tab active" id="receivedTab" aria-selected="true">❤️ People who liked me <span id="receivedCount" class="count">0</span></button>
<button type="button" class="tab" id="sentTab" aria-selected="false">💗 People I liked <span id="sentCount" class="count">0</span></button>
</div>

<section id="receivedPanel" class="panel">
<h2>People who liked you</h2>
<p class="panel-note">These members have shown interest in your profile.</p>
<div id="receivedList" class="loading">Loading received likes...</div>
</section>

<section id="sentPanel" class="panel hidden">
<h2>People you liked</h2>
<p class="panel-note">These are the members whose profiles you have liked.</p>
<div id="sentList" class="loading">Loading sent likes...</div>
</section>
</div>
</main>

<footer>© <span id="year"></span> Mubeezi Dating · Connecting Hearts Worldwide</footer>

<script>
const SUPABASE_URL = "https://xxtlcdvuiyrdufzvzeob.supabase.co";
const SUPABASE_KEY = "sb_publishable_KOs2uLOuyzOVLhg9H5gJJw_1pUYvlsU";
const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

const statusBox = document.getElementById("status");
const profileBox = document.getElementById("profile");
const likesArea = document.getElementById("likesArea");
const fallbackPhoto = "https://placehold.co/400x400/fce4ec/c2185b?text=Member";

document.getElementById("year").textContent = new Date().getFullYear();

function setText(id, value, fallback = "Not provided") {
    const el = document.getElementById(id);
    el.textContent = value === null || value === undefined || value === ""
        ? fallback : String(value);
}

function calculateAge(dateOfBirth) {
    if (!dateOfBirth) return "";
    const birth = new Date(dateOfBirth + "T00:00:00");
    if (Number.isNaN(birth.getTime())) return "";
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    if (today.getMonth() < birth.getMonth() ||
        (today.getMonth() === birth.getMonth() && today.getDate() < birth.getDate())) age--;
    return age >= 0 ? age : "";
}

function showMessage(element, message, isError = false) {
    element.className = isError ? "empty error" : "empty";
    element.textContent = message;
}

function memberCard(member) {
    const card = document.createElement("article");
    card.className = "member-card";

    const img = document.createElement("img");
    img.src = member.profile_photo || fallbackPhoto;
    img.alt = "Member profile photo";
    img.onerror = () => { img.onerror = null; img.src = fallbackPhoto; };

    const info = document.createElement("div");
    info.className = "member-info";

    const name = document.createElement("strong");
    name.textContent = member.display_name || member.full_name || member.username || "Mubeezi Member";

    const location = document.createElement("small");
    location.textContent = [member.age ? member.age + " years" : "", member.country || ""]
        .filter(Boolean).join(" · ") || "Mubeezi Dating member";

    const link = document.createElement("a");
    link.href = "view-profile.html?id=" + encodeURIComponent(member.id);
    link.textContent = "View Profile";

    info.append(name, location, link);
    card.append(img, info);
    return card;
}

async function loadLikeGroup(targetElement, userIds, countElement) {
    countElement.textContent = String(userIds.length);

    if (!userIds.length) {
        showMessage(targetElement, "No likes to show here yet. Keep discovering members on Mubeezi Dating.");
        return;
    }

    const uniqueIds = [...new Set(userIds)].filter(Boolean);
    const { data, error } = await db
        .from("profiles")
        .select("id,display_name,full_name,username,age,date_of_birth,country,profile_photo")
        .in("id", uniqueIds);

    if (error) {
        console.error("Could not load liked member profiles:", error);
        showMessage(targetElement, "The likes were found, but member profiles could not be loaded. Check your profiles table permissions.", true);
        return;
    }

    if (!data || !data.length) {
        showMessage(targetElement, "No member profiles are available to display.");
        return;
    }

    const byId = new Map(data.map(member => [member.id, member]));
    targetElement.className = "member-list";
    targetElement.replaceChildren();

    uniqueIds.forEach(id => {
        const member = byId.get(id);
        if (member) {
            if (!member.age && member.date_of_birth) member.age = calculateAge(member.date_of_birth);
            targetElement.appendChild(memberCard(member));
        }
    });

    if (!targetElement.children.length) {
        showMessage(targetElement, "No visible member profiles are available to display.");
    }
}

async function loadLikes(userId) {
    const receivedList = document.getElementById("receivedList");
    const sentList = document.getElementById("sentList");

    const [receivedResult, sentResult] = await Promise.all([
        db.from("profile_likes").select("liker_id").eq("liked_id", userId),
        db.from("profile_likes").select("liked_id").eq("liker_id", userId)
    ]);

    if (receivedResult.error) {
        console.error("Received likes error:", receivedResult.error);
        document.getElementById("receivedCount").textContent = "—";
        showMessage(receivedList, "We couldn't load people who liked you. Check the profile_likes table and its Row Level Security policies.", true);
    } else {
        await loadLikeGroup(receivedList,
            (receivedResult.data || []).map(row => row.liker_id),
            document.getElementById("receivedCount"));
    }

    if (sentResult.error) {
        console.error("Sent likes error:", sentResult.error);
        document.getElementById("sentCount").textContent = "—";
        showMessage(sentList, "We couldn't load the members you liked. Check the profile_likes table and its Row Level Security policies.", true);
    } else {
        await loadLikeGroup(sentList,
            (sentResult.data || []).map(row => row.liked_id),
            document.getElementById("sentCount"));
    }
}

function setupTabs() {
    const receivedTab = document.getElementById("receivedTab");
    const sentTab = document.getElementById("sentTab");
    const receivedPanel = document.getElementById("receivedPanel");
    const sentPanel = document.getElementById("sentPanel");

    receivedTab.addEventListener("click", () => {
        receivedTab.classList.add("active");
        sentTab.classList.remove("active");
        receivedTab.setAttribute("aria-selected", "true");
        sentTab.setAttribute("aria-selected", "false");
        receivedPanel.classList.remove("hidden");
        sentPanel.classList.add("hidden");
    });

    sentTab.addEventListener("click", () => {
        sentTab.classList.add("active");
        receivedTab.classList.remove("active");
        sentTab.setAttribute("aria-selected", "true");
        receivedTab.setAttribute("aria-selected", "false");
        sentPanel.classList.remove("hidden");
        receivedPanel.classList.add("hidden");
    });
}

async function loadMyProfile() {
    try {
        const { data: sessionData, error: sessionError } = await db.auth.getSession();
        if (sessionError) throw sessionError;

        const user = sessionData.session && sessionData.session.user;
        if (!user) {
            location.href = "login.html";
            return;
        }

        const { data: profile, error } = await db
            .from("profiles")
            .select("*")
            .eq("id", user.id)
            .maybeSingle();

        if (error) throw error;

        if (!profile) {
            statusBox.textContent = "Your profile has not been created yet. Please complete your profile.";
            const link = document.createElement("a");
            link.href = "complete-profile.html";
            link.textContent = "Complete My Profile";
            link.style.cssText = "display:block;margin-top:15px;color:#e91e63;font-weight:bold";
            statusBox.appendChild(link);
            return;
        }

        const name = profile.display_name || profile.full_name || profile.username || "Mubeezi Member";
        const age = profile.age || calculateAge(profile.date_of_birth);

        setText("name", name);
        setText("ageCountry",
            [age ? age + " years old" : "", profile.city, profile.country].filter(Boolean).join(" · "),
            "Welcome to your profile");
        setText("bio", profile.bio);
        setText("occupation", profile.occupation);
        setText("education", profile.education);
        setText("relationshipGoal", profile.relationship_goal);
        setText("country", profile.country);

        let interests = profile.interests;
        if (Array.isArray(interests)) interests = interests.join(", ");
        setText("interests", interests);

        setText("profileStatus", profile.profile_visible ? "Published" : "Not published");

        const photo = document.getElementById("photo");
        photo.src = profile.profile_photo || fallbackPhoto;
        photo.onerror = () => { photo.onerror = null; photo.src = fallbackPhoto; };

        statusBox.classList.add("hidden");
        profileBox.classList.remove("hidden");
        likesArea.classList.remove("hidden");

        setupTabs();
        await loadLikes(user.id);

    } catch (error) {
        console.error("My profile error:", error);
        statusBox.textContent = "We couldn't load your profile: " + (error.message || "Please check your profiles table and permissions.");
        statusBox.classList.add("error");
    }
}

loadMyProfile();
</script>
</body>
</html>
